# Project Z environment variables.
#
# Copy to `.env` for local dev. Each variable lists where it must be set:
#   Local    your .env / .env.*.local files
#   Vercel   Vercel project env (Production and/or Preview)
#   GitHub   GitHub Actions repo secret (or variable where noted), read by the
#            shared CI in crashoutcompany/.github
#   Cursor   written automatically by .cursor/dev for Cloud Agents
#
# CI (lint/test/e2e) uses its own fixtures for DATABASE_URL, DIRECT_URL,
# BETTER_AUTH_SECRET and TEST_AUTH_SECRET; the CI build pulls everything else
# from Vercel, so those don't need GitHub secrets.

# --- Database (Neon Postgres) -----------------------------------------------
# Local, Vercel (Production + Preview), Cursor
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
# Local, Vercel (Production + Preview), Cursor. Unpooled URL for Prisma.
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# --- Auth (Better Auth) -----------------------------------------------------
# Local, Vercel (Production + Preview), Cursor. 32+ random chars; different per environment.
BETTER_AUTH_SECRET=""
# Local (optional), Vercel Production. Preview derives it from VERCEL_BRANCH_URL.
BETTER_AUTH_URL="http://localhost:3000"
# Local, Vercel (Production + Preview), Cursor (placeholders). Optional; provider hidden when unset.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Email OTP sign-in for allowlisted (bot) accounts only. Enabled only when all
# three are set. AUTH_EMAIL_FROM must be on a domain verified in Resend.
AUTH_OTP_ALLOWED_EMAILS=""
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""

# --- Agent / e2e test login (never on Vercel Production) --------------------
# Local, Cursor. Enables POST /api/test-auth/login with header x-test-auth-secret.
TEST_AUTH_SECRET=""
# Local, Cursor. Must be "1" for the test login route to exist.
EXPOSE_TESTING_API=""
# Local (optional). Point Playwright at an already-running server.
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
# Local (optional). Only when PLAYWRIGHT_BASE_URL is a protected Vercel preview.
# VERCEL_AUTOMATION_BYPASS_SECRET=""

# --- AI ---------------------------------------------------------------------
# Local, Vercel (Production + Preview). Gemini natural-language card search.
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Scripts ----------------------------------------------------------------
# Local. Vercel Blob token for card image import scripts.
# BLOB_READ_WRITE_TOKEN=""
# Local (optional). Cap cards per set in scripts/import-cards.ts.
# SEED_PER_SET_LIMIT=""

# --- GitHub Actions only (Settings -> Secrets and variables -> Actions) -----
# VERCEL_TOKEN=""        GitHub secret. CI `vercel build`.
# VERCEL_ORG_ID=""       GitHub secret. CI `vercel build`.
# VERCEL_PROJECT_ID=""   GitHub secret. CI `vercel build`.
# NEON_API_KEY=""        GitHub secret. e2e + Neon preview branches.
# NEON_PROJECT_ID=""     GitHub variable (or secret). e2e + Neon preview branches.
# NEON_DATABASE=""       GitHub variable or secret. Optional, defaults to neondb.
# NEON_ROLE=""           GitHub variable or secret. Optional, defaults to neondb_owner.
